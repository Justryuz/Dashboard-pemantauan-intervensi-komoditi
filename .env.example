# Salin fail ini kepada .env dan isi nilai sebenar. JANGAN commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# API
API_BASE_URL=http://localhost:3000/api
API_KEY=
# Data cuaca MET Malaysia (dapatkan token di api.met.gov.my; jangan commit .env)
MET_API_TOKEN=
MET_API_BASE=
# Data banjir (JPS) dan kualiti udara (JAS): tiada kunci diperlukan
BANJIR_RADIUS_KM=25
BANJIR_POLL_MIN=30
BANJIR_DATA_MAX_JAM=3
IPU_POLL_MIN=60
IPU_STALE_JAM=3
# Kunci peta Carto (isi sendiri; jangan commit .env)
CARTO_API_KEY=
# Pangkalan data
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Lain-lain
# Senarai origin dibenarkan, dipisah koma. Kosong = hanya same-origin.
CORS_ORIGIN=

# AI Muse (Google Drive db-curated). Kunci Drive API pilihan: kosong = guna paparan folder HTML. Jangan commit .env.
GOOGLE_API_KEY=
MUSE_DRIVE_FOLDER_ID=1wXNm0nG7dUOvNWkepN9ev3BcgwFZEn8M
# Bilangan minggu dikekalkan dan selang semakan (jam)
MUSE_WEEKS=8
MUSE_POLL_JAM=6
# Amaran cuaca data.gov.my (tiada kunci): selang semakan (minit), AMARAN_DG_AUTO=0 mematikan pengambilan automatik
AMARAN_DG_POLL_MIN=30
